<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Host Your Home</title>
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- 1. Define Settings -->
    <script>
        window.UPLOADCARE_PUBLIC_KEY = '6e6dc40288887f5d88e3';
        window.UPLOADCARE_LOOK_FOR_INPUTS = false; // We will trigger it manually to be safe
    </script>
    
    <!-- 2. Load Library -->
    <script src="https://cdn.jsdelivr.net/npm/uploadcare-widget@3.x/uploadcare.full.min.js" charset="utf-8"></script>

    <style>
        /* This ensures the widget has enough space to appear */
        .uploadcare--widget {
            background: #fff;
            padding: 8px;
            border-radius: 8px;
            border: 1px solid #ebebeb;
            min-width: 200px;
        }
        .uploadcare--widget__button_type_open {
            background-color: #ff385c !important;
        }
    </style>
</head>
<body>

    <%- include('../partials/nav.ejs') %>

<div class="host-container">
    <h2><%= editing ? 'Edit your listing' : 'List your home' %></h2>
    <p class="subtitle">
        <%= editing ? 'Update the details of your property.' : 'Tell us a bit about your place to get started.' %>
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
        <div style="background: #ffebe9; border: 1px solid #cc0000; color: #cc0000; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            <%= error %>
        </div>
    <% } %>

    <form action="/host/<%= editing ? 'edit-home' : 'home-added' %>" method="POST">
        
        <!-- SECTION 1: PHOTO UPLOAD -->
        <div class="form-group" style="margin-bottom: 25px;">
            <label style="display: block; margin-bottom: 10px;">Property Photo <span style="color: #ff385c;">*</span></label>
            
            <div style="border: 2px dashed #DDDDDD; border-radius: 12px; padding: 25px; text-align: center; background: #F7F7F7;" id="photo-box">
                <input 
                    type="hidden" 
                    role="uploadcare-uploader" 
                    name="image" 
                    data-images-only="true"
                    data-clearable="true"
                    value="<%= editing ? home.imageUrl : '' %>"
                    <%= editing ? '' : 'required' %>
                >
            </div>
        </div>

        <!-- SECTION 2: PDF RULES UPLOAD -->
        <div class="form-group" style="margin-bottom: 25px;">
            <label style="display: block; margin-bottom: 10px;">Property Rules (PDF) <span style="color: #ff385c;">*</span></label>
            
            <div style="border: 2px dashed #DDDDDD; border-radius: 12px; padding: 25px; text-align: center; background: #F7F7F7;" id="rules-box">
                <input 
                    type="hidden" 
                    role="uploadcare-uploader" 
                    name="rules" 
                    data-file-types="pdf"
                    data-clearable="true"
                    value="<%= editing ? home.rulesUrl : '' %>"
                    <%= editing ? '' : 'required' %>
                >
            </div>
        </div>

        <!-- OTHER FORM FIELDS -->
        <div class="form-group">
            <label for="house-name">House Name <span style="color: #ff385c;">*</span></label>
            <input type="text" id="house-name" name="houseName" value="<%= editing ? home.houseName : '' %>" required>
        </div>

        <div class="form-group">
            <label for="location">Location <span style="color: #ff385c;">*</span></label>
            <input type="text" id="location" name="location" value="<%= editing ? home.location : '' %>" required>
        </div>

        <div class="form-group">
            <label for="price">Price per night ($) <span style="color: #ff385c;">*</span></label>
            <input type="number" id="price" name="price" value="<%= editing ? home.price : '' %>" min="1" required>
        </div>

        <div class="form-group">
            <label for="description">Brief Description <span style="color: #ff385c;">*</span></label>
            <input type="text" id="description" name="description" value="<%= editing ? home.description : '' %>" required>
        </div>

        <div class="form-group">
            <label for="direction">Facing Direction <span style="color: #ff385c;">*</span></label>
            <input type="text" id="direction" name="facing" value="<%= editing ? home.facing : '' %>" required>
        </div>

        <div class="form-group">
            <label for="instructions">Special Instructions <span style="color: #ff385c;">*</span></label>
            <input type="text" id="instructions" name="instructions" value="<%= editing ? home.instructions : '' %>" required>
        </div>

        <div class="form-group">
            <label for="contact">Owner Contact Details <span style="color: #ff385c;">*</span></label>
            <input type="email" id="contact" name="contactEmail" value="<%= editing ? home.contactEmail : '' %>" required>
        </div>

        <% if (editing) { %>
            <input type="hidden" name="homeId" value="<%= home._id %>">
        <% } %>

        <button type="submit" class="submit-btn" style="margin-top: 20px;">
            <%= editing ? 'Update Listing' : 'Continue' %>
        </button>
    </form>
</div>

<script>
    // Force manual start
    document.addEventListener('DOMContentLoaded', function() {
        uploadcare.start();
        
        // Connect the specific inputs
        const imageWidget = uploadcare.Widget('[name="image"]');
        const rulesWidget = uploadcare.Widget('[name="rules"]');

        imageWidget.onUploadComplete(function(info) {
            document.getElementById('photo-box').style.borderColor = '#008489';
        });

        rulesWidget.onUploadComplete(function(info) {
            document.getElementById('rules-box').style.borderColor = '#008489';
        });
    });
</script>

</body>
</html>