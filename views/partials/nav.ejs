<nav style="
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    padding: 0 80px; 
    height: 80px; 
    border-bottom: 1px solid #ebebeb; 
    background: white; 
    position: sticky; 
    top: 0; 
    z-index: 1000;">

    <!-- Left: Logo and Host Badge -->
    <div style="flex: 1; display: flex; align-items: center; gap: 12px;">
        <a href="/" style="color: #FF385C; font-size: 24px; font-weight: 800; text-decoration: none; letter-spacing: -1px;">airbnb</a>
        
        <% if (isLoggedIn && user && user.userType === 'host') { %>
            <span style="height: 24px; width: 1px; background: #DDDDDD;"></span>
            <span style="font-size: 14px; font-weight: 600; color: #222;">Host Mode</span>
        <% } %>
    </div>

    <!-- Center: Navigation Links -->
    <div style="display: flex; gap: 32px; align-items: center;">
        <% if (isLoggedIn && user && user.userType === 'host') { %>
            <!-- HOST NAV -->
            <!-- HOST NAV -->
    <a href="/host/manage-listing" style="
        text-decoration: none; 
        color: <%= currentPage === 'manage-listing' ? '#222' : '#717171' %>; 
        font-size: 15px; 
        font-weight: <%= currentPage === 'manage-listing' ? '700' : '400' %>;">
        View Storefront
    </a>

    <a href="/host/home-added" style="
        text-decoration: none; 
        color: <%= currentPage === 'home-added' ? '#222' : '#717171' %>; 
        font-size: 15px; 
        font-weight: <%= currentPage === 'home-added' ? '700' : '400' %>;">
        Add New Listing
    </a>
        <% } else { %>
            <!-- USER/GUEST NAV -->
            <!-- <a href="/" style="text-decoration: none; 
                color: <%= currentPage === 'home' ? '#222' : '#717171' %>; 
                font-size: 15px; 
                font-weight: <%= currentPage === 'home' ? '700' : '400' %>;">Home</a> -->

            <% if (isLoggedIn) { %>
            <a href="/" style="text-decoration: none; 
                color: <%= currentPage === 'home' ? '#222' : '#717171' %>; 
                font-size: 15px; 
                font-weight: <%= currentPage === 'home' ? '700' : '400' %>;">Home</a>
                <a href="/bookings" style="text-decoration: none; 
                    color: <%= currentPage === 'bookings' ? '#222' : '#717171' %>; 
                    font-size: 15px; 
                    font-weight: <%= currentPage === 'bookings' ? '700' : '400' %>;">Bookings</a>

                <a href="/favourites" style="text-decoration: none; 
                    color: <%= currentPage === 'favourites' ? '#222' : '#717171' %>; 
                    font-size: 15px; 
                    font-weight: <%= currentPage === 'favourites' ? '700' : '400' %>;">Favorites</a>

                <!-- MOVED: Help is now only visible if Logged In -->
                <a href="/contact" style="text-decoration: none; 
                    color: <%= currentPage === 'contact' ? '#222' : '#717171' %>; 
                    font-size: 15px; 
                    font-weight: <%= currentPage === 'contact' ? '700' : '400' %>;">Help</a>
            <% } %>
        <% } %>
    </div>

    <!-- Right: Login/Logout & User Icon -->
    <div style="flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 12px;">
        
        <% if (!isLoggedIn) { %>
            <a href="/login" style="
                text-decoration: none; 
                color: #222; 
                font-size: 14px; 
                font-weight: 600; 
                padding: 12px 16px; 
                border-radius: 24px; 
                transition: background 0.2s;" 
                onmouseover="this.style.background='#f7f7f7'" 
                onmouseout="this.style.background='transparent'">
                Login
            </a>
        <% } else { %>
            <form action="/logout" method="POST" style="margin: 0;">
                <button type="submit" style="
                    background: none;
                    border: none;
                    color: #222; 
                    font-size: 14px; 
                    font-weight: 600; 
                    padding: 12px 16px; 
                    border-radius: 24px; 
                    cursor: pointer;
                    transition: background 0.2s;" 
                    onmouseover="this.style.background='#f7f7f7'" 
                    onmouseout="this.style.background='transparent'">
                    Logout
                </button>
            </form>
        <% } %>

        <!-- Visual Badge for User/Host -->
        <div style="
            display: flex; 
            align-items: center; 
            gap: 12px; 
            border: 1px solid #DDDDDD; 
            padding: 8px; 
            border-radius: 30px;">
            <div style="width: 32px; height: 32px; 
                background: <%= (isLoggedIn && user && user.userType === 'host') ? '#FF385C' : '#717171' %>; 
                border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 9px; font-weight: bold;">
                <%= (isLoggedIn && user && user.userType === 'host') ? 'HOST' : 'USER' %>
            </div>
        </div>
    </div>
</nav>