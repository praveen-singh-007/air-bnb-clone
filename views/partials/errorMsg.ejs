<% if (errors && errors.length > 0) { %>
    <div class="error-container" style="background-color: #fff8f6; border: 1px solid #c13515; padding: 12px; border-radius: 8px; margin-bottom: 20px;">
        <ul class="error-list" style="margin: 0; padding-left: 20px; color: #c13515; font-size: 14px; font-family: inherit;">
            <% errors.forEach(msg => { %>
                <% if (msg) { %>
                    <li><%= msg %></li>
                <% } %>
            <% }) %>
        </ul>
    </div>
<% } %>