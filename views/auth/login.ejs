<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login - Airbnb</title>
    <style>
        body { font-family: 'Circular', -apple-system, system-ui, Roboto, sans-serif; background-color: #f7f7f7; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .login-card { background: white; width: 100%; max-width: 500px; border-radius: 12px; box-shadow: 0 8px 28px rgba(0,0,0,0.28); overflow: hidden; }
        .header { border-bottom: 1px solid #ddd; padding: 20px; text-align: center; font-weight: 700; font-size: 16px; }
        .content { padding: 24px; }
        .welcome-text { font-size: 22px; font-weight: 600; margin-bottom: 24px; color: #222; }
        .form-group { position: relative; margin-bottom: 12px; }
        input { width: 100%; padding: 18px 12px; border: 1px solid #b0b0b0; border-radius: 8px; font-size: 16px; box-sizing: border-box; }
        input:focus { outline: 2px solid #222; border-color: transparent; }
        .submit-btn { width: 100%; background: linear-gradient(to right, #E61E4D 0%, #E31C5F 50%, #D70466 100%); color: white; border: none; padding: 14px; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; margin-top: 16px; }
        .submit-btn:hover { opacity: 0.9; }
        .footer-text { font-size: 12px; color: #717171; margin-top: 16px; text-align: center; }
        .divider { display: flex; align-items: center; text-align: center; margin: 16px 0; font-size: 12px; color: #717171; }
        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px solid #ddd; }
        .divider:not(:empty)::before { margin-right: .5em; }
        .divider:not(:empty)::after { margin-left: .5em; }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="header">Log in</div>
        <div class="content">
            <div class="welcome-text">Welcome to Airbnb</div>
            <%- include('../partials/errorMsg.ejs', {errors: errors}) %>
            <form action="/login" method="POST">
                <div class="form-group">
                    <input type="email" name="email" placeholder="Email" required>
                </div>
                <div class="form-group">
                    <input type="password" name="password" placeholder="Password" required>
                </div>
                <p class="footer-text">We’ll call or text you to confirm your number. Standard message and data rates apply.</p>
                <button type="submit" class="submit-btn">Continue</button>
            </form>

            <div class="divider">or</div>

                <a href="/register" style="
                    display: block;
                    text-align: center;
                    text-decoration: none;
                    color: #222;
                    width: 100%; 
                    padding: 12px; 
                    border: 1px solid #222; 
                    background: white; 
                    border-radius: 8px; 
                    font-weight: 600; 
                    box-sizing: border-box;
                    cursor: pointer;">
                    Not Registered? Sign-Up Here
                </a>
        </div>
    </div>

</body>
</html>